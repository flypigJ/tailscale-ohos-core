diff --git a/util/mesharcdiag/mesharcdiag.go b/util/mesharcdiag/mesharcdiag.go
new file mode 100644
index 0000000..55e17bd
--- /dev/null
+++ b/util/mesharcdiag/mesharcdiag.go
@@ -0,0 +1,449 @@
+// Copyright (c) MeshArc contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Package mesharcdiag records opt-in, bounded, address-free path diagnostics.
+// Never pass formatted logs to it. Names are enumerated below, identifiers are
+// HMACed before storage, and all remaining fields are numeric.
+package mesharcdiag
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/netip"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+const Capacity = 1536
+const MaxSeconds = 300
+const MaxPerSecond = 120
+
+var kinds = map[string]bool{}
+var reasons = map[string]bool{}
+
+func init() {
+	for _, s := range []string{"capture", "host_network", "host_protection", "host_monitor", "socket_bind", "socket_rebind", "socket_snapshot", "receive_loop", "udp_receive", "udp_write", "stun_send", "stun_receive", "restun", "netcheck", "netcheck_cache", "disco_send", "disco_receive", "disco_drop", "ping", "pong", "endpoint", "data_path", "active_probe"} {
+		kinds[s] = true
+	}
+	for _, s := range []string{"start", "stop", "expired", "cleared", "replaced", "requested", "queued", "coalesced", "closed", "stopped", "offline", "unavailable", "unknown", "ok", "error", "suppressed", "udp4", "udp6", "derp", "peer_relay", "direct", "disco", "stun", "wireguard", "unknown_peer", "unknown_relay", "no_key", "decrypt_failed", "decrypted", "parse_failed", "parsed", "invalid_transport", "unknown_txid", "expired_txid", "endpoint_removed", "matched", "candidate", "promoted", "retained", "ping", "pong", "call_me_maybe", "other", "timeout", "busy", "rate_limited", "cancelled", "skipped", "complete", "not_selected", "no_derp_map", "wrong_family", "truncated", "protected", "fallback", "wifi", "cellular", "pending", "network_changed", "stale", "failed", "observed"} {
+		reasons[s] = true
+	}
+}
+
+type Event struct {
+	Sequence     uint64 `json:"seq"`
+	TimestampMS  int64  `json:"timestampMs"`
+	ElapsedMS    int64  `json:"elapsedMs"`
+	NetworkEpoch uint64 `json:"networkEpoch"`
+	SocketEpoch  uint64 `json:"socketEpoch,omitempty"`
+	Kind         string `json:"kind"`
+	Result       string `json:"result"`
+	Family       int    `json:"family,omitempty"`
+	Peer         string `json:"peer,omitempty"`
+	Endpoint     string `json:"endpoint,omitempty"`
+	Tx           string `json:"tx,omitempty"`
+	Errno        int64  `json:"errno,omitempty"`
+	// N is a fixed numeric tuple, interpreted by kind. No arbitrary log fields.
+	N []int64 `json:"n,omitempty"`
+}
+
+type Counter struct {
+	Kind   string `json:"kind"`
+	Result string `json:"result"`
+	Count  uint64 `json:"count"`
+}
+
+type Coverage struct {
+	Kind  string `json:"kind"`
+	State string `json:"state"`
+	Count uint64 `json:"count"`
+}
+
+type Snapshot struct {
+	Coverage          []Coverage `json:"coverage"`
+	Schema            int        `json:"schema"`
+	Session           string     `json:"session"`
+	Active            bool       `json:"active"`
+	StartedMS         int64      `json:"startedMs"`
+	DeadlineMS        int64      `json:"deadlineMs"`
+	StoppedMS         int64      `json:"stoppedMs"`
+	StopReason        string     `json:"stopReason"`
+	NetworkEpoch      uint64     `json:"networkEpoch"`
+	Capacity          int        `json:"capacity"`
+	Overwritten       uint64     `json:"overwritten"`
+	RateDropped       uint64     `json:"rateDropped"`
+	ContentionDropped uint64     `json:"contentionDropped"`
+	InvalidDropped    uint64     `json:"invalidDropped"`
+	SampledOut        uint64     `json:"sampledOut"`
+	Counters          []Counter  `json:"counters"`
+	Events            []Event    `json:"events"`
+	Missing           []string   `json:"missing"`
+}
+
+type session struct {
+	expired    [128][6]byte
+	expiredAt  int
+	expiredLen int
+
+	mu                                              sync.Mutex
+	secret                                          [32]byte
+	id                                              string
+	started, deadline                               time.Time
+	stopped                                         time.Time
+	reason                                          string
+	ctx                                             context.Context
+	cancel                                          context.CancelFunc
+	active                                          atomic.Bool
+	epoch                                           atomic.Uint64
+	socket4                                         atomic.Uint64
+	socket6                                         atomic.Uint64
+	seq, overwritten, rateDropped, invalid, sampled uint64
+	contention                                      atomic.Uint64
+	window                                          int64
+	used                                            int
+	ring                                            [Capacity]Event
+	head, length                                    int
+	counters                                        map[string]uint64
+	lastSample                                      map[string]time.Time
+}
+
+var current atomic.Pointer[session]
+var lifecycle sync.Mutex
+var epoch atomic.Uint64
+var sockets4, sockets6 atomic.Uint64
+
+// Start replaces the previous capture. No persistent setting re-enables it.
+func Start(seconds int) error {
+	lifecycle.Lock()
+	defer lifecycle.Unlock()
+	if seconds < 1 || seconds > MaxSeconds {
+		seconds = 180
+	}
+	s := &session{started: time.Now(), reason: "pending", counters: map[string]uint64{}, lastSample: map[string]time.Time{}}
+	if _, err := rand.Read(s.secret[:]); err != nil {
+		return err
+	}
+	// The session ID discloses no HMAC key bytes: derive it separately.
+	id := sha256.Sum256(append([]byte("session:"), s.secret[:]...))
+	s.id = hex.EncodeToString(id[:8])
+	s.deadline = s.started.Add(time.Duration(seconds) * time.Second)
+	s.ctx, s.cancel = context.WithDeadline(context.Background(), s.deadline)
+	s.epoch.Store(epoch.Load())
+	s.socket4.Store(sockets4.Load())
+	s.socket6.Store(sockets6.Load())
+	s.active.Store(true)
+	if old := current.Swap(s); old != nil {
+		stopSession(old, "replaced")
+	}
+	record(s, "capture", "start", 0, "", "", nil, nil, false, int64(seconds))
+	go func() {
+		<-s.ctx.Done()
+		if s.active.Load() {
+			stopSession(s, "expired")
+		}
+	}()
+	return nil
+}
+
+func stopSession(s *session, reason string) {
+	s.mu.Lock()
+	if s.active.Swap(false) {
+		s.stopped = time.Now()
+		s.reason = reason
+		s.cancel()
+	}
+	s.mu.Unlock()
+}
+
+func Stop() {
+	if s := current.Load(); s != nil {
+		stopSession(s, "stop")
+	}
+}
+func Clear() {
+	lifecycle.Lock()
+	defer lifecycle.Unlock()
+	if s := current.Swap(nil); s != nil {
+		stopSession(s, "cleared")
+	}
+}
+func Enabled() bool {
+	s := current.Load()
+	return s != nil && s.active.Load() && time.Now().Before(s.deadline)
+}
+func Context() context.Context {
+	if s := current.Load(); s != nil {
+		return s.ctx
+	}
+	c, cancel := context.WithCancel(context.Background())
+	cancel()
+	return c
+}
+func Epoch() uint64          { return epoch.Load() }
+func NetworkChanged() uint64 { return epoch.Add(1) }
+func SocketChanged(family int) uint64 {
+	if family == 6 {
+		return sockets6.Add(1)
+	}
+	return sockets4.Add(1)
+}
+
+func Family(ip netip.Addr) int {
+	if ip.Is4() {
+		return 4
+	}
+	if ip.Is6() {
+		return 6
+	}
+	return 0
+}
+func ErrorCode(err error) int64 {
+	if err == nil {
+		return 0
+	}
+	var errno syscall.Errno
+	if errors.As(err, &errno) {
+		return int64(errno)
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return -2
+	}
+	if errors.Is(err, context.Canceled) {
+		return -3
+	}
+	return -1 // No error text, addresses or formatted arguments enter the cache.
+}
+func Result(err error) string {
+	if err == nil {
+		return "ok"
+	}
+	return "error"
+}
+
+func TxID(tx []byte) string {
+	if len(tx) < 6 {
+		return ""
+	}
+	// Upstream Windows logs show the first six random TxID bytes. A public,
+	// domain-separated hash permits correlation without keys, node IDs or IPs.
+	b := append([]byte("mesharc-disco-tx-v1:"), tx[:6]...)
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:12])
+}
+
+func pseudonym(s *session, domain, raw string) string {
+	if raw == "" {
+		return ""
+	}
+	h := hmac.New(sha256.New, s.secret[:])
+	h.Write([]byte(domain))
+	h.Write([]byte{0})
+	h.Write([]byte(raw))
+	return hex.EncodeToString(h.Sum(nil)[:12])
+}
+
+// Record never blocks the network on diagnostics locks. Disabled calls do not
+// hash, format or allocate. Optional numbers have at most eight numeric values.
+func Record(kind, result string, family int, peer, endpoint string, tx []byte, err error, n ...int64) {
+	s := current.Load()
+	if s == nil || !s.active.Load() || !time.Now().Before(s.deadline) {
+		return
+	}
+	record(s, kind, result, family, peer, endpoint, tx, err, false, n...)
+}
+
+// Sample bounds per-packet data-path/receive observations to one per second per
+// kind/family, with counters of omitted observations. It does not imply loss.
+func Sample(kind, result string, family int, peer, endpoint string, n ...int64) {
+	s := current.Load()
+	if s == nil || !s.active.Load() || !time.Now().Before(s.deadline) {
+		return
+	}
+	record(s, kind, result, family, peer, endpoint, nil, nil, true, n...)
+}
+
+func record(s *session, kind, result string, family int, peer, endpoint string, tx []byte, err error, sample bool, n ...int64) {
+	if !s.mu.TryLock() {
+		s.contention.Add(1)
+		return
+	}
+	defer s.mu.Unlock()
+	if !s.active.Load() {
+		return
+	}
+	if !kinds[kind] || !reasons[result] || (family != 0 && family != 4 && family != 6) || len(n) > 8 {
+		s.invalid++
+		return
+	}
+	now := time.Now()
+	if !now.Before(s.deadline) {
+		return
+	}
+	s.counters[kind+"/"+result]++
+	if sample {
+		key := kind + string(rune(family))
+		last := s.lastSample[key]
+		if now.Sub(last) < time.Second {
+			s.sampled++
+			return
+		}
+		s.lastSample[key] = now
+	}
+	if s.window != now.Unix() {
+		s.window = now.Unix()
+		s.used = 0
+	}
+	if s.used >= MaxPerSecond {
+		s.rateDropped++
+		return
+	}
+	s.used++
+	s.seq++
+	e := Event{Sequence: s.seq, TimestampMS: now.UnixMilli(), ElapsedMS: now.Sub(s.started).Milliseconds(), NetworkEpoch: epoch.Load(), Kind: kind, Result: result, Family: family, Peer: pseudonym(s, "peer", peer), Endpoint: pseudonym(s, "endpoint", endpoint), Tx: TxID(tx), Errno: ErrorCode(err), N: append([]int64(nil), n...)}
+	if family == 4 {
+		e.SocketEpoch = sockets4.Load()
+	}
+	if family == 6 {
+		e.SocketEpoch = sockets6.Load()
+	}
+	i := (s.head + s.length) % Capacity
+	if s.length == Capacity {
+		i = s.head
+		s.head = (s.head + 1) % Capacity
+		s.overwritten++
+	} else {
+		s.length++
+	}
+	s.ring[i] = e
+}
+
+func Read() Snapshot {
+	s := current.Load()
+	if s == nil {
+		return Snapshot{Schema: 1, StopReason: "never_started", Events: []Event{}, Missing: []string{"capture_not_started"}}
+	}
+	if !time.Now().Before(s.deadline) {
+		stopSession(s, "expired")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	r := Snapshot{Schema: 1, Session: s.id, Active: s.active.Load(), StartedMS: s.started.UnixMilli(), DeadlineMS: s.deadline.UnixMilli(), StopReason: s.reason, NetworkEpoch: epoch.Load(), Capacity: Capacity, Overwritten: s.overwritten, RateDropped: s.rateDropped, ContentionDropped: s.contention.Load(), InvalidDropped: s.invalid, SampledOut: s.sampled, Counters: []Counter{}, Events: make([]Event, s.length), Missing: []string{"kernel_egress_not_observed", "remote_delivery_not_observed", "per_socket_nethandle_binding_not_used", "raw_payload_not_collected", "addresses_and_keys_not_collected"}}
+	if !s.stopped.IsZero() {
+		r.StoppedMS = s.stopped.UnixMilli()
+	}
+	for k, v := range s.counters {
+		parts := strings.SplitN(k, "/", 2)
+		r.Counters = append(r.Counters, Counter{Kind: parts[0], Result: parts[1], Count: v})
+	}
+	sort.Slice(r.Counters, func(i, j int) bool {
+		a, b := r.Counters[i], r.Counters[j]
+		if a.Kind == b.Kind {
+			return a.Result < b.Result
+		}
+		return a.Kind < b.Kind
+	})
+	for i := 0; i < s.length; i++ {
+		r.Events[i] = s.ring[(s.head+i)%Capacity]
+	}
+	for _, k := range []string{"netcheck", "socket_bind", "disco_receive", "pong"} {
+		found := false
+		for name := range s.counters {
+			if len(name) > len(k) && name[:len(k)+1] == k+"/" {
+				found = true
+				break
+			}
+		}
+		if !found {
+			r.Missing = append(r.Missing, k+"_not_observed_in_capture")
+		}
+	}
+	for _, kind := range []string{"socket_bind", "socket_snapshot", "receive_loop", "udp_receive", "netcheck", "stun_receive", "disco_receive", "pong", "endpoint", "data_path"} {
+		var count uint64
+		for _, counter := range r.Counters {
+			if counter.Kind == kind {
+				count += counter.Count
+			}
+		}
+		state := "observed"
+		if count == 0 {
+			state = "observed_zero"
+			if kind == "socket_bind" || kind == "netcheck" || kind == "receive_loop" {
+				state = "not_captured"
+			}
+			if r.ContentionDropped > 0 {
+				state = "unknown_due_to_drops"
+			}
+		}
+		r.Coverage = append(r.Coverage, Coverage{Kind: kind, State: state, Count: count})
+	}
+	return r
+}
+
+func JSON() string {
+	b, err := json.Marshal(Read())
+	if err != nil {
+		return `{"schema":1,"missing":["serialization_failed"]}`
+	}
+	return string(b)
+}
+
+// RecordIn prevents an asynchronous operation from crossing capture boundaries.
+func RecordIn(ctx context.Context, kind, result string, family int, peer, endpoint string, tx []byte, err error, n ...int64) {
+	s := current.Load()
+	if s == nil || s.ctx != ctx || !s.active.Load() || !time.Now().Before(s.deadline) {
+		return
+	}
+	record(s, kind, result, family, peer, endpoint, tx, err, false, n...)
+}
+
+func MarkExpired(tx []byte) {
+	s := current.Load()
+	if s == nil || !s.active.Load() || len(tx) < 6 || !time.Now().Before(s.deadline) {
+		return
+	}
+	if !s.mu.TryLock() {
+		s.contention.Add(1)
+		return
+	}
+	defer s.mu.Unlock()
+	copy(s.expired[s.expiredAt][:], tx[:6])
+	s.expiredAt = (s.expiredAt + 1) % len(s.expired)
+	if s.expiredLen < len(s.expired) {
+		s.expiredLen++
+	}
+}
+func UnknownPongReason(tx []byte) string {
+	s := current.Load()
+	if s == nil || len(tx) < 6 || !s.active.Load() {
+		return "unknown_txid"
+	}
+	if !s.mu.TryLock() {
+		s.contention.Add(1)
+		return "unknown_txid"
+	}
+	defer s.mu.Unlock()
+	var k [6]byte
+	copy(k[:], tx[:6])
+	for i := 0; i < s.expiredLen; i++ {
+		if s.expired[i] == k {
+			return "expired_txid"
+		}
+	}
+	return "unknown_txid"
+}
+
+func SocketEpoch(family int) uint64 {
+	if family == 6 {
+		return sockets6.Load()
+	}
+	return sockets4.Load()
+}
