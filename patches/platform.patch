+func TestPathDiagnosticDiscoRejectionStages(t *testing.T) {
+	diagnosticCapture(t)
+	c := newConn(logger.Discard)
+	c.privateKey = key.NewNode()
+	remote := key.NewDisco()
+	src := epAddr{ap: netip.MustParseAddrPort("[2001:db8::9]:41641")}
+	header := append([]byte(disco.Magic), remote.Public().AppendTo(nil)...)
+	c.handleDiscoMessage(append(header, make([]byte, 64)...), src, false, key.NodePublic{}, discoRXPathUDP)
+	if !diagnosticHas("disco_drop", "unknown_peer") {
+		t.Fatal("unknown peer missing")
+	}
+	c.peerMap.nodesOfDisco[remote.Public()] = set.Set[key.NodePublic]{}
+	c.handleDiscoMessage(append(header, make([]byte, 64)...), src, false, key.NodePublic{}, discoRXPathUDP)
+	if !diagnosticHas("disco_drop", "decrypt_failed") {
+		t.Fatal("decrypt rejection missing")
+	}
+	shared := remote.Shared(c.discoAtomic.Public())
+	c.handleDiscoMessage(append(header, shared.Seal([]byte{255, 0})...), src, false, key.NodePublic{}, discoRXPathUDP)
+	if !diagnosticHas("disco_drop", "parse_failed") {
+		t.Fatal("parse rejection missing")
+	}
+	tx := [12]byte{1, 2, 3, 4, 5, 6}
+	payload := (&disco.Pong{TxID: tx}).AppendMarshal(nil)
+	c.handleDiscoMessage(append(header, shared.Seal(payload)...), src, false, key.NodePublic{}, discoRXPathUDP)
+	if !diagnosticHas("pong", "parsed") || !diagnosticHas("pong", "unknown_txid") {
+		t.Fatal("parsed and accepted conflated")
+	}
+	mesharcdiag.MarkExpired(tx[:])
+	c.handleDiscoMessage(append(header, shared.Seal(payload)...), src, false, key.NodePublic{}, discoRXPathUDP)
+	if !diagnosticHas("pong", "expired_txid") {
+		t.Fatal("late pong missing")
+	}
+}
