new file mode 100644
index 0000000..b718447
--- /dev/null
+++ b/util/mesharcdiag/mesharcdiag_test.go
@@ -0,0 +1,141 @@
+package mesharcdiag
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestDisabledAndPrivacy(t *testing.T) {
+	Clear()
+	Record("ping", "ok", 6, "nodekey:secret", "[2001:db8::123]:41641", nil, errors.New("Bearer secret"))
+	if len(Read().Events) != 0 {
+		t.Fatal("disabled recorded")
+	}
+	if a := testing.AllocsPerRun(100, func() { Record("ping", "ok", 6, "secret", "10.0.0.1", nil, nil) }); a != 0 {
+		t.Fatalf("disabled allocs %v", a)
+	}
+	if err := Start(1); err != nil {
+		t.Fatal(err)
+	}
+	Record("ping", "ok", 6, "nodekey:secret", "[2001:db8::123]:41641", []byte{1, 2, 3, 4, 5, 6, 7}, errors.New("Bearer secret / 10.0.0.1 / disco-key"))
+	Record("token-secret", "ok", 4, "", "", nil, nil)
+	j := JSON()
+	for _, x := range []string{"nodekey:secret", "2001:db8", "10.0.0.1", "Bearer secret", "disco-key", "token-secret"} {
+		if strings.Contains(j, x) {
+			t.Fatalf("leaked %s", x)
+		}
+	}
+	first := Read().Events[1].Endpoint
+	Start(1)
+	Record("ping", "ok", 6, "nodekey:secret", "[2001:db8::123]:41641", nil, nil)
+	if first == Read().Events[1].Endpoint {
+		t.Fatal("alias reused")
+	}
+	Stop()
+	before := len(Read().Events)
+	Record("ping", "ok", 6, "", "", nil, nil)
+	if len(Read().Events) != before {
+		t.Fatal("stopped recorded")
+	}
+	if Read().StoppedMS == 0 || Read().StopReason != "stop" {
+		t.Fatal("stop metadata missing")
+	}
+	Clear()
+}
+
+func TestBoundsAndConcurrency(t *testing.T) {
+	Start(10)
+	defer Clear()
+	s := current.Load()
+	for i := 0; i < Capacity+100; i++ {
+		s.mu.Lock()
+		s.used = 0
+		s.mu.Unlock()
+		Record("pong", "unknown_txid", 6, "peer", "ip", nil, nil, int64(i))
+	}
+	r := Read()
+	if len(r.Events) != Capacity || r.Overwritten == 0 {
+		t.Fatal("ring not bounded")
+	}
+	for i := 0; i < 300; i++ {
+		Record("ping", "ok", 4, "", "", nil, nil)
+	}
+	if Read().RateDropped == 0 {
+		t.Fatal("no rate accounting")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 1000; j++ {
+				NetworkChanged()
+				Record("pong", "decrypt_failed", 6, "", "", nil, nil)
+				_ = Read()
+			}
+		}()
+	}
+	wg.Wait()
+	if len(JSON()) > 1<<20 {
+		t.Fatal("export exceeds byte budget")
+	}
+	ctx := Context()
+	Stop()
+	select {
+	case <-ctx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("probe cancellation failed")
+	}
+}
+
+func TestExpiryEpochErrorsAndCorrelation(t *testing.T) {
+	Start(1)
+	defer Clear()
+	NetworkChanged()
+	SocketChanged(6)
+	Record("socket_bind", "error", 6, "", "", nil, syscall.EACCES)
+	r := Read()
+	e := r.Events[len(r.Events)-1]
+	if e.Errno != int64(syscall.EACCES) || e.NetworkEpoch == 0 || e.SocketEpoch == 0 {
+		t.Fatal("missing errno/epochs")
+	}
+	if ErrorCode(context.DeadlineExceeded) != -2 || ErrorCode(context.Canceled) != -3 {
+		t.Fatal("error categories")
+	}
+	if TxID([]byte{1, 2, 3, 4, 5, 6, 7}) != TxID([]byte{1, 2, 3, 4, 5, 6, 8}) {
+		t.Fatal("Windows prefix correlation")
+	}
+	s := current.Load()
+	s.mu.Lock()
+	s.deadline = time.Now().Add(-time.Second)
+	s.mu.Unlock()
+	if Read().StopReason != "expired" || Enabled() {
+		t.Fatal("expiry")
+	}
+}
+
+func TestCaptureBoundaryAndCoverage(t *testing.T) {
+	Start(30)
+	old := Context()
+	Start(30)
+	defer Clear()
+	RecordIn(old, "ping", "ok", 6, "old", "old", nil, nil)
+	if len(Read().Events) != 1 {
+		t.Fatal("old capture recorded")
+	}
+	r := Read()
+	found := false
+	for _, c := range r.Coverage {
+		if c.Kind == "disco_receive" && c.State == "observed_zero" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("zero observation state missing")
+	}
+}
