+	if err := c.bindSocket(&c.pconn4, "udp4", keepCurrentPort); err != nil {
+		t.Fatal(err)
+	}
+	c.PathDiagnosticSnapshot()
+	if !diagnosticHas("socket_bind", "error") || !diagnosticHas("socket_snapshot", "unavailable") || !diagnosticHas("socket_bind", "ok") {
+		t.Fatal("failed and real sockets conflated")
