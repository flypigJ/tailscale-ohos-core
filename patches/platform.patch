+package ipnstate_test
+
+import (
+	"encoding/json"
+	"strings"
+	"tailscale.com/ipn/ipnstate"
+	"tailscale.com/types/key"
+	"testing"
+)
+
+func TestMeshArcPeerMetadataMerge(t *testing.T) {
+	peer := key.NewNode().Public()
+	builder := &ipnstate.StatusBuilder{WantPeers: true}
+	builder.AddPeer(peer, &ipnstate.PeerStatus{HostName: "test", OS: "harmonyos"})
+	builder.AddPeer(peer, &ipnstate.PeerStatus{DeviceModel: "test-model", OSVersion: "test-version"})
+	builder.AddPeer(peer, &ipnstate.PeerStatus{})
+	status := builder.Status().Peer[peer]
+	if status.HostName != "test" || status.DeviceModel != "test-model" || status.OSVersion != "test-version" {
+		t.Fatal("peer metadata was lost when merging status")
+	}
+	encoded, err := json.Marshal(status)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, field := range []string{`"DeviceModel":"test-model"`, `"OSVersion":"test-version"`} {
+		if !strings.Contains(string(encoded), field) {
+			t.Fatal("peer metadata JSON compatibility changed")
+		}
+	}
+}
