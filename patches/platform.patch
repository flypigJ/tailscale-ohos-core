diff --git a/tsnet/mesharc.go b/tsnet/mesharc.go
new file mode 100644
index 0000000..3bff9b5
--- /dev/null
+++ b/tsnet/mesharc.go
@@ -0,0 +1,118 @@
+package tsnet
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"time"
+
+	"tailscale.com/net/netmon"
+	"tailscale.com/util/mesharcdiag"
+)
+
+func (s *Server) TaildriveHTTPClient() (*http.Client, error) {
+	if err := s.Start(); err != nil {
+		return nil, err
+	}
+	if s.taildriveFS == nil {
+		return nil, errors.New("tsnet: Taildrive filesystem unavailable")
+	}
+	fs := s.taildriveFS
+
+	transport := &http.Transport{
+		Proxy:               nil,
+		ForceAttemptHTTP2:   false,
+		MaxIdleConns:        4,
+		MaxIdleConnsPerHost: 4,
+		IdleConnTimeout:     60 * time.Second,
+		DialContext: func(_ context.Context, network, address string) (net.Conn, error) {
+			if network != "tcp" && network != "tcp4" && network != "tcp6" {
+				return nil, fmt.Errorf("tsnet: Taildrive unexpected network %q", network)
+			}
+			if address != "100.100.100.100:8080" {
+				return nil, fmt.Errorf("tsnet: Taildrive unexpected destination %q", address)
+			}
+
+			clientConn, serverConn := net.Pipe()
+			remoteAddr := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 0}
+			go func() {
+				if err := fs.HandleConn(serverConn, remoteAddr); err != nil {
+					_ = serverConn.Close()
+				}
+			}()
+			return clientConn, nil
+		},
+	}
+	return &http.Client{Transport: transport}, nil
+}
+
+func (s *Server) NotifyNetworkChange(ctx context.Context, interfaceName string) (err error) {
+	started := time.Now()
+	defer func() {
+		mesharcdiag.Record("host_monitor", mesharcdiag.Result(err), 0, "", "", nil, err, time.Since(started).Milliseconds())
+	}()
+	if s.lb == nil || s.lb.NetMon() == nil {
+		return errors.New("tsnet: network monitor unavailable")
+	}
+	mesharcdiag.NetworkChanged()
+	if mesharcdiag.Enabled() {
+		mesharcdiag.Record("host_network", "network_changed", 0, "", interfaceName, nil, nil)
+	}
+	netmon.UpdateLastKnownDefaultRouteInterface(interfaceName)
+	mon := s.lb.NetMon()
+	changed := make(chan struct{}, 1)
+	unregister := mon.RegisterChangeCallback(func(*netmon.ChangeDelta) {
+		select {
+		case changed <- struct{}{}:
+		default:
+		}
+	})
+	defer unregister()
+	mon.InjectEvent()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-changed:
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if interfaceName == "" {
+			return nil
+		}
+		// A netId or address can change without changing the interface name.
+		// Explicit rebind also restarts discovery when netmon calls it minor.
+		if err := s.lb.DebugRebind(); err != nil {
+			return err
+		}
+		// Refresh discovery after rebind so peers learn the physical-network address.
+		return s.lb.DebugReSTUN()
+	}
+}
+
+func (s *Server) NetworkDiagnostics() string {
+	if s.lb == nil || s.lb.MagicConn() == nil {
+		return "netCheck=unavailable"
+	}
+	mc := s.lb.MagicConn()
+	r := mc.GetLastNetcheckReport(context.Background())
+	if r == nil {
+		return "netCheck=pending"
+	}
+	return fmt.Sprintf("netUDP=%t | netIPv4=%t | netIPv6=%t | netMappingVaries=%s | netPort=%d",
+		r.UDP, r.IPv4, r.IPv6, r.MappingVariesByDestIP, mc.LocalPort())
+}
+
+func (s *Server) PathDiagnosticSnapshot() {
+	if s.lb != nil && s.lb.MagicConn() != nil {
+		s.lb.MagicConn().PathDiagnosticSnapshot()
+	}
+}
+
+func (s *Server) RequestPathDiagnosticSTUN() error {
+	if s.lb == nil {
+		return errors.New("backend unavailable")
+	}
+	return s.lb.DebugReSTUN()
+}
