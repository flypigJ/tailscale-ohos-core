@@ -0,0 +1,76 @@
+package taildrop
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"tailscale.com/ipn"
+	"tailscale.com/ipn/ipnext"
+	"tailscale.com/tstime"
+	"tailscale.com/util/must"
+)
+
+func TestMeshArcReceivedTime(t *testing.T) {
+	root := t.TempDir()
+	manager := managerOptions{Logf: t.Logf, Clock: tstime.DefaultClock{}, fileOps: must.Get(newFileOps(root)), SendFileNotify: func() {}}.New()
+	defer manager.Shutdown()
+	if _, err := manager.PutFile(clientID("test"), "received.txt", strings.NewReader("test"), 0, 4); err != nil {
+		t.Fatal(err)
+	}
+	received := time.UnixMilli(1700000000123)
+	if err := os.Chtimes(filepath.Join(root, "received.txt"), received, received); err != nil {
+		t.Fatal(err)
+	}
+	files, err := manager.WaitingFiles()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) != 1 || files[0].ReceivedAtMs != received.UnixMilli() {
+		t.Fatal("waiting file lost its receive timestamp")
+	}
+}
+
+type meshArcNotifyHost struct {
+	ipnext.Host
+	notifications []ipn.Notify
+}
+
+func (host *meshArcNotifyHost) SendNotifyAsync(notification ipn.Notify) {
+	host.notifications = append(host.notifications, notification)
+}
+
+func TestMeshArcOutgoingProgressCoalescesAndFlushes(t *testing.T) {
+	host := &meshArcNotifyHost{}
+	progress := newOutgoingProgress(&Extension{host: host})
+	progress.last = time.Now()
+	progress.notifyInterval = time.Hour
+	var workers sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		workers.Go(func() {
+			for sent := int64(0); sent < 1000; sent++ {
+				progress.update(ipn.OutgoingFile{ID: "transfer", Sent: sent})
+			}
+		})
+	}
+	workers.Wait()
+	progress.update(ipn.OutgoingFile{ID: "transfer", Sent: 1000, Finished: true, Succeeded: true})
+	if len(host.notifications) != 0 || len(progress.pending) != 1 {
+		t.Fatal("hot-path progress did not coalesce")
+	}
+	progress.notify()
+	if len(host.notifications) != 1 || len(host.notifications[0].OutgoingFiles) != 1 {
+		t.Fatal("completion was not flushed")
+	}
+	final := host.notifications[0].OutgoingFiles[0]
+	if final.Sent != 1000 || !final.Finished || !final.Succeeded {
+		t.Fatal("completion state was lost")
+	}
+	progress.notify()
+	if len(host.notifications) != 1 {
+		t.Fatal("empty flush produced another notification")
+	}
+}
