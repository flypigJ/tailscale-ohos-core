new file mode 100644
index 0000000..21c958c
--- /dev/null
+++ b/wgengine/magicsock/path_diagnostics.go
@@ -0,0 +1,101 @@
+package magicsock
+
+import (
+	"net"
+	"strconv"
+	"tailscale.com/disco"
+	"tailscale.com/tailcfg"
+	"tailscale.com/util/mesharcdiag"
+	"time"
+)
+
+func pathDiagBool(v bool) int64 {
+	if v {
+		return 1
+	}
+	return 0
+}
+func pathDiagFamily(network string) int {
+	if network == "udp6" {
+		return 6
+	}
+	return 4
+}
+func pathDiagMessageCode(kind string) int64 {
+	switch kind {
+	case "ping":
+		return 1
+	case "pong":
+		return 2
+	case "call_me_maybe":
+		return 3
+	}
+	return 0
+}
+func (c *Conn) pathDiagCacheAge() int64 {
+	at := c.pathDiagReportAt.Load()
+	if at == 0 {
+		return -1
+	}
+	return time.Now().UnixMilli() - at
+}
+func (c *Conn) PathDiagnosticSnapshot() {
+	if !mesharcdiag.Enabled() {
+		return
+	}
+	for _, f := range []int{4, 6} {
+		ruc := &c.pconn4
+		if f == 6 {
+			ruc = &c.pconn6
+		}
+		ruc.mu.Lock()
+		reason := "unavailable"
+		port := int64(-1)
+		local := ""
+		if ruc.pconn != nil {
+			if _, dummy := ruc.pconn.(*blockForeverConn); !dummy {
+				reason = "ok"
+				a := ruc.localAddrLocked()
+				port = int64(a.Port)
+				local = a.String()
+			}
+		}
+		ruc.mu.Unlock()
+		mesharcdiag.Record("socket_snapshot", reason, f, "", local, nil, nil, port)
+	}
+	r := c.lastNetCheckReport.Load()
+	reason := "pending"
+	if r != nil {
+		reason = "ok"
+		if c.pathDiagReportEpoch.Load() != mesharcdiag.Epoch() {
+			reason = "stale"
+		}
+	}
+	n := []int64{c.pathDiagCacheAge(), int64(c.pathDiagReportEpoch.Load())}
+	if r != nil {
+		n = append(n, pathDiagBool(r.UDP), pathDiagBool(r.IPv4), pathDiagBool(r.IPv6))
+	}
+	mesharcdiag.Record("netcheck_cache", reason, 0, "", "", nil, nil, n...)
+}
+
+// Keep the protocol dependency explicit for source/ABI audit tools.
+var _ disco.Message = (*disco.Pong)(nil)
+
+func pathDiagSourceFamily(src epAddr) int {
+	if src.ap.Addr() == tailcfg.DerpMagicIPAddr {
+		return 0
+	}
+	return mesharcdiag.Family(src.ap.Addr())
+}
+
+func pathDiagPort(a net.Addr) int64 {
+	_, p, e := net.SplitHostPort(a.String())
+	if e != nil {
+		return -1
+	}
+	v, e := strconv.ParseInt(p, 10, 32)
+	if e != nil {
+		return -1
+	}
+	return v
+}
