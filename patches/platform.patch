+func TestPathDiagnosticSlabReceiveAndSocketEpoch(t *testing.T) {
+	diagnosticCapture(t)
+	c := newConn(logger.Discard)
+	c.connCtx = context.Background()
+	c.pconn4.mu.Lock()
+	c.pconn4.setConnLocked(&diagnosticReadConn{}, "udp4", nil)
+	c.pconn4.mu.Unlock()
+	defer c.pconn4.Close()
+	mesharcdiag.SocketChanged(4)
+	epoch := mesharcdiag.SocketEpoch(4)
+	receive := c.mkReceiveFunc(&c.pconn4, nil, nil, nil, nil, nil)
+	// An unauthenticated packet is observed but never passed to WireGuard.
+	n, err := receive(make([]byte, 2048), make([]conn.ReceivedPacket, 1))
+	if n != 0 || !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("receive returned %d, %v", n, err)
+	}
+	if !diagnosticHas("udp_receive", "ok") || !diagnosticHas("receive_loop", "error") {
+		t.Fatal("slab receive evidence lost")
+	}
+	found := false
+	for _, event := range mesharcdiag.Read().Events {
+		if event.Kind == "udp_receive" {
+			if len(event.N) < 2 || event.N[0] != 64 || event.N[1] != int64(epoch) {
+				t.Fatal("receive size/socket generation changed")
+			}
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("missing UDP receive event")
+	}
+}
