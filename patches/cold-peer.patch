@@ -0,0 +1,35 @@
+package tsnet
+
+import (
+	"net/netip"
+	"testing"
+
+	"tailscale.com/ipn/store/mem"
+)
+
+// A cold control map must not send a canonical tailnet destination through
+// the system dialer: the HarmonyOS application is excluded from its own TUN.
+func TestMeshArcExternalTunColdPeerDialPlan(t *testing.T) {
+	controlURL, _ := startControl(t)
+	s := &Server{Dir: t.TempDir(), ControlURL: controlURL, Hostname: "cold-dial", Store: new(mem.Store), Ephemeral: true, Tun: newChanTUN()}
+	t.Cleanup(func() { s.Close() })
+	if _, err := s.Up(t.Context()); err != nil {
+		t.Fatal(err)
+	}
+	for _, address := range []string{"100.64.255.254", "fd7a:115c:a1e0::dead"} {
+		t.Run(address, func(t *testing.T) {
+			ip := netip.MustParseAddr(address)
+			if _, known := s.lb.PeerForIP(ip); known {
+				t.Fatal("fixture unexpectedly knows peer")
+			}
+			got, viaTailnet, err := s.dialer.UserDialPlan(t.Context(), "tcp", netip.AddrPortFrom(ip, 80).String())
+			if err != nil || got.Addr() != ip || !viaTailnet {
+				t.Fatalf("unknown canonical tailnet address falls back to system: viaTailnet=%v err=%v", viaTailnet, err)
+			}
+		})
+	}
+	_, viaTailnet, err := s.dialer.UserDialPlan(t.Context(), "tcp", "192.0.2.1:80")
+	if err != nil || viaTailnet {
+		t.Fatalf("unrouted public destination changed: viaTailnet=%v err=%v", viaTailnet, err)
+	}
+}
