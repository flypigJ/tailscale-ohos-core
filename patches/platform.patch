+	t.Cleanup(ec.Close)
+	c.portUpdatePub = eventbus.Publish[router.PortUpdate](ec)
+	c.health = new(health.Tracker)
+	c.testOnlyPacketListener = diagnosticFakeListener{}
+	if c.bindSocket(&c.pconn6, "udp6", keepCurrentPort) == nil {
+		t.Fatal("expected IPv6 failure")
